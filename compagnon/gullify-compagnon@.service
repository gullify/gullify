[Unit]
# Un service par pile : gullify-compagnon@maxime, gullify-compagnon@service…
# Les réglages de chacune vivent dans /etc/gullify-compagnon/<nom>.conf :
#   PROJET=gullify-perso
#   PILE=/home/maxime/gullify-perso
#   SOURCE=/home/maxime/gullify      (vide pour un serveur posé par l'installateur)
Description=Compagnon GulliFY (%i) — redémarrage et mise à jour demandés depuis l'app
After=docker.service
Requires=docker.service

[Service]
Type=simple
User=maxime
Group=maxime
EnvironmentFile=/etc/gullify-compagnon/%i.conf
ExecStart=/home/maxime/gullify/compagnon/gullify-compagnon.sh ${PROJET} ${PILE} ${SOURCE}
Restart=always
RestartSec=10
NoNewPrivileges=true
# Pas de ProtectHome : construire une image demande à buildx d'écrire son
# état sous ~/.docker, et un home en lecture seule faisait échouer la mise à
# jour d'un serveur qui porte le code — sans rien protéger de plus, puisque
# ce service tourne de toute façon en tant que la personne qui peut tout y
# faire à la main.
PrivateTmp=false

[Install]
WantedBy=multi-user.target
