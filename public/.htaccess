# gullify.app/tv répond SANS redirection.
#
# L'adresse se tape à la télécommande, dans un gestionnaire de téléchargement.
# « tv » n'est donc volontairement PAS un répertoire : mod_dir renverrait un
# 301 vers « /tv/ » — et ce 301 repart en http:// derrière le proxy, ce que
# certains clients refusent de suivre.
RewriteEngine On
RewriteRule ^tv$ tv.php [L]

# L'app web (/app/) : toujours demander au serveur si un fichier a changé.
#
# Sans directive, le navigateur DEVINE combien de temps garder un fichier —
# environ 10 % de son âge — et une app installée resservait l'ancienne version
# des heures après un déploiement, rafraîchissement compris. Flutter ne met
# pas de version dans le nom de ses fichiers (main.dart.js reste main.dart.js).
#
# « no-cache » ne veut pas dire « ne rien garder » : le navigateur garde ses
# copies, mais les revalide à chaque ouverture. Rien n'a changé ? Le serveur
# répond « 304 », sans renvoyer un octet.
#
# Pas d'ETag ici, volontairement : quand Apache compresse, il suffixe l'ETag
# de « -gzip », puis ne reconnaît plus ce même ETag quand le navigateur le lui
# renvoie — chaque ouverture retéléchargeait 1,4 Mo. La revalidation passe
# donc par la date de modification, que chaque construction renouvelle.
<If "%{REQUEST_URI} =~ m#^/app/#">
  FileETag None
  <IfModule mod_headers.c>
    Header set Cache-Control "no-cache"
  </IfModule>
</If>


# La racine EST l'app, sur un serveur personnel.
#
# L'app web est construite avec un « base href » à la racine : elle demande
# /main.dart.js, /assets/…, /canvaskit/…. Ces fichiers vivent dans public/app/,
# où la construction les dépose. On les y renvoie — mais seulement si rien
# d'autre ne répond : les API, les images, le flux et la page de présentation
# de gullify.app sont de vrais fichiers, ils gagnent.
<IfModule mod_rewrite.c>
  RewriteCond %{REQUEST_URI} !^/app/
  RewriteCond %{DOCUMENT_ROOT}%{REQUEST_URI} !-f
  RewriteCond %{DOCUMENT_ROOT}%{REQUEST_URI} !-d
  RewriteCond %{DOCUMENT_ROOT}/app%{REQUEST_URI} -f
  RewriteRule ^(.*)$ /app/$1 [L]

  # Et pour tout le reste : la coque de l'app.
  #
  # L'app a des adresses à elle (/recherche, /album/12…). Rafraîchir une de ces
  # pages, ou l'ouvrir depuis un signet, demande au serveur un chemin qui
  # n'existe pas sur le disque — il faut lui rendre la coque, qui saura quoi
  # afficher. Les fichiers réels (les API, le flux, les images) ont déjà
  # gagné plus haut : cette règle ne voit passer que ce qui n'existe pas.
  RewriteCond %{REQUEST_URI} !^/app/
  RewriteCond %{DOCUMENT_ROOT}%{REQUEST_URI} !-f
  RewriteCond %{DOCUMENT_ROOT}%{REQUEST_URI} !-d
  RewriteRule ^(.*)$ /index.php [L]
</IfModule>
