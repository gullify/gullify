# Gullify Configuration
GULLIFY_SETUP_DONE=false

# MySQL
MYSQL_HOST=db
MYSQL_PORT=3306
MYSQL_DATABASE=gullify
MYSQL_USER=gullify
MYSQL_PASSWORD=changeme
MYSQL_ROOT_PASSWORD=changeme_root

# Host path to your music library (used by docker-compose volume mount)
# This is the path ON YOUR HOST machine, not inside the container.
# Example: /home/john/music, /mnt/nas/music, /data/music
MUSIC_HOST_PATH=./music

# Container-internal paths (usually no need to change)
MUSIC_BASE_PATH=/music
DATA_PATH=/app/data

# App
# Your domain name — Caddy will automatically get a Let's Encrypt SSL certificate.
# Use a real domain (e.g. music.example.com) for HTTPS, or "localhost" for local dev.
APP_DOMAIN=music.example.com
APP_URL=https://music.example.com
APP_DEBUG=false
# Secret key for encrypting SFTP passwords — change this to a long random string
APP_SECRET=change_me_to_a_long_random_secret_key

# Last.fm API (optional — for artist biographies and similar artists)
# Get a free key at https://www.last.fm/api/account/create
LASTFM_API_KEY=

# Android app download URL — surfaced in Settings → Apps as a download link.
# Leave empty to hide the section entirely.
GULLIFY_ANDROID_URL=https://download.gullify.app/gullify-latest.apk
GULLIFY_ANDROID_VERSION=

# ─────────────────────────────────────────────────────────────────────────────
# Service d'inscription des serveurs — le serveur CENTRAL seulement
#
# Laisse REGISTRY_DOMAIN vide sur une installation ordinaire : c'est lui qui
# allume le service, et un serveur de salon n'a pas à distribuer de noms.
# ─────────────────────────────────────────────────────────────────────────────
# Le domaine sous lequel vivent les sous-domaines des utilisateurs.
REGISTRY_DOMAIN=
# « ionos » en production, « fictif » pour essayer sans toucher au vrai DNS.
REGISTRY_DNS=fictif
# Clé API IONOS, au format prefixe.secret (espace client → API DNS).
IONOS_API_KEY=

# Envoi de courriel (confirmation d'adresse, avertissement d'expiration).
# « journal » écrit dans un fichier au lieu d'envoyer — pratique pour essayer.
MAIL_DRIVER=journal
MAIL_FROM="GulliFY <bonjour@gullify.app>"
MAIL_HTTP_URL=
MAIL_HTTP_TOKEN=
MAIL_LOG=
